{
  "name": "pokemon-tcg-collection",
  "private": true,
  "version": "1.62.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/build-holo-css.mjs",
    "build": "vite build && node scripts/build-sw.mjs",
    "check:translations": "node scripts/check-translations.mjs",
    "preview": "vite preview",
    "test": "npm run check:translations && node --test scripts/translation-validation.test.mjs scripts/holo-deployment.test.mjs scripts/configure-public-mode.test.mjs scripts/pwa-assets.test.mjs scripts/nginx-config.test.mjs scripts/build-sw.test.mjs scripts/configure-pwa.test.mjs && vitest run src",
    "test:pwa": "playwright test --config=playwright.pwa.config.js",
    "test:visual": "playwright test",
    "test:visual:webkit": "playwright test --config=playwright.webkit.config.js",
    "test:visual:update": "playwright test --update-snapshots",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.18.0",
    "@tanstack/react-virtual": "3.14.27",
    "axios": "^1.20.0",
    "clsx": "^2.1.0",
    "date-fns": "^3.3.1",
    "lucide-react": "^0.323.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^7.18.2",
    "recharts": "^2.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^6.0.2",
    "fake-indexeddb": "6.2.5",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
