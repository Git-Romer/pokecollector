# Initial bootstrap settings for the backend container
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Optional: `single` temporarily disables authentication for local recovery;
# `multi` forces the login screen. Leave blank for the in-app setting.
USER_MODE=
# Leave JWT_SECRET_KEY blank to auto-generate and persist a strong signing key.
# Only set it to pin a specific value or share one across replicas. Do not commit a real value.
JWT_SECRET_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# OpenAI-compatible scanner provider. Set OPENAI_BASE_URL to a local server to use
# Ollama, llama.cpp or LM Studio; leave it unset for the hosted OpenAI API.
# The endpoint is deliberately an administrator setting rather than a per-user one:
# a user-supplied backend URL would let any account point the server at an
# arbitrary host. Users choose the provider and supply their own key in Settings.
# Each user enters their own OpenAI key in Settings; a local endpoint usually
# needs none at all.
# From inside the backend container, 127.0.0.1 is that container, not the host,
# so a model running on the host is reached via host.docker.internal instead.
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# Any vision-capable model the endpoint offers. gpt-5.6-luna reads cards as
# accurately as gpt-4o-mini in our testing while spending far fewer image
# tokens; users can override this individually in Settings.
OPENAI_MODEL=gpt-5.6-luna
# Optional server-side scanner diagnostics. Users still opt in individually.
# Keep SCAN_TRACE_STORAGE_DIR stable so users can delete previously stored data
# even while collection is disabled. Docker Compose sets this automatically.
# SCAN_TRACE_STORAGE_DIR=/app/data/scan-traces
# SCAN_TRACE_DIR=/app/data/scan-traces
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TCGDEX_SYNC_LANGUAGES=en,de
PUBLIC_MODE=false
CORS_ORIGINS=

# Automatic safety backup before startup migrations on version changes
PRE_UPGRADE_BACKUP_ENABLED=true
PRE_UPGRADE_BACKUP_REQUIRED=true
PRE_UPGRADE_BACKUP_KEEP=10
