# Initial bootstrap settings for the backend container
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Optional: `single` temporarily disables authentication for local recovery;
# `multi` forces the login screen. Leave blank for the in-app setting.
USER_MODE=
# Authentication policy: `local` keeps username/password login only, `mixed`
# adds single sign-on for linked accounts, and `oidc-only` disables password
# login (it requires an administrator already linked in mixed mode). Leave
# blank or set `local` for the current behaviour; unknown values fail startup.
AUTH_MODE=local
# Single sign-on (OIDC) provider settings. One issuer per deployment. Leave
# these blank unless AUTH_MODE is `mixed` or `oidc-only`; provider settings
# alone never enable OIDC in local mode.
# Issuer and redirect URI must be absolute HTTPS URLs; plain HTTP is accepted
# only for literal localhost/127.0.0.1/[::1] development.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
# Set the client secret only in your private .env file; never commit a real value.
OIDC_CLIENT_SECRET=
# Must end with the exact path /api/auth/oidc/callback on the public origin.
OIDC_REDIRECT_URI=
# Friendly label for the login button.
OIDC_DISPLAY_NAME=Single sign-on
# Leave JWT_SECRET_KEY blank to auto-generate and persist a strong signing key.
# Only set it to pin a specific value or share one across replicas. Do not commit a real value.
JWT_SECRET_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# OpenAI-compatible scanning is hidden until an administrator enables it.
OPENAI_SCANNER_ENABLED=false
# Optional friendly name shown to users, for example "Local Ollama".
# OPENAI_PROVIDER_LABEL=Local Ollama
# Set OPENAI_BASE_URL to a local server to use Ollama, llama.cpp or LM Studio;
# leave it unset for the hosted OpenAI API.
# The endpoint is deliberately an administrator setting rather than a per-user one:
# a user-supplied backend URL would let any account point the server at an
# arbitrary host. Users choose the provider and supply their own key in Settings.
# Each user enters their own key in Settings when the endpoint requires one.
# OPENAI_API_KEY_REQUIRED can explicitly override hosted/local inference.
# OPENAI_API_KEY_REQUIRED=true
# From inside the backend container, 127.0.0.1 is that container, not the host,
# so a model running on the host is reached via host.docker.internal instead.
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# The default and administrator-approved model list. Every model must support
# images and the Chat Completions API. Users choose only from this list.
OPENAI_MODEL=gpt-5.6-luna
# OPENAI_ALLOWED_MODELS=gpt-5.6-luna
# GEMINI_ALLOWED_MODELS=gemini-flash-latest
# Optional server-side scanner diagnostics. Users still opt in individually.
# Keep SCAN_TRACE_STORAGE_DIR stable so users can delete previously stored data
# even while collection is disabled. Docker Compose sets this automatically.
# SCAN_TRACE_STORAGE_DIR=/app/data/scan-traces
# SCAN_TRACE_DIR=/app/data/scan-traces
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TCGDEX_SYNC_LANGUAGES=en,de
PUBLIC_MODE=false

# Optional installable-app and offline features (see docs/PWA.md). Both default to off.
# PWA_ENABLED=true lets browsers save the app shell for offline start (needs HTTPS);
# PWA_ENABLED=false is the kill switch and removes an installed service worker.
# OFFLINE_QUEUE_ENABLED=true turns on the offline scan queue, cached sign-in and sync
# center; setting it back to false stops the queue and keeps waiting items on the device.
# Recreate the frontend container after changing either.
# PWA_ENABLED=false
# OFFLINE_QUEUE_ENABLED=false
CORS_ORIGINS=

# Optional image-tag override for controlled deployments or rollbacks.
# Leave unset to use the exact version bundled with docker-compose.yml.
# POKECOLLECTOR_VERSION=1.51.7

# Host ports, if 8000 or 3000 are already taken on this host.
# Container ports are unaffected.
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Automatic safety backup before startup migrations on version changes
PRE_UPGRADE_BACKUP_ENABLED=true
PRE_UPGRADE_BACKUP_REQUIRED=true
PRE_UPGRADE_BACKUP_KEEP=10
